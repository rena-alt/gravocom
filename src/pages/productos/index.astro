---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

const productos = await getCollection('productos');

const equiposLaser = productos.filter(p => p.data.category === 'Marcado Láser' && !p.slug.includes('limpiadora'));

const limpiadoras = productos.filter(p => p.slug.includes('limpiadora') || p.data.title.toLowerCase().includes('limpiadora'));
---

<Layout 
  title="Catálogo de Equipos y Sistemas Láser de Fibra | Gravocom"
  description="Explora nuestra gama de sistemas de marcado y limpieza industrial. Fuentes Raycus/Max de alta performance diseñadas para procesos de alta exigencia."
>
  <main class="max-w-7xl mx-auto px-6 py-16">
    
    <header class="mb-20">
      <div class="flex items-center gap-4 mb-4">
        <span class="h-1 w-12 bg-orange-500"></span>
        <span class="text-orange-600 font-black uppercase tracking-[0.2em] text-sm">Portafolio de Soluciones</span>
      </div>
      <h1 class="text-5xl md:text-7xl font-black text-slate-900 mb-6 uppercase tracking-tighter">
        Equipos y <span class="text-orange-500">Tecnología Industrial</span>
      </h1>
      <p class="text-xl text-slate-600 max-w-3xl leading-relaxed border-l-4 border-slate-200 pl-6">
        Explora nuestra gama de sistemas industriales de marcado y limpieza láser de fibra diseñados para procesos de alta exigencia[cite: 1].
      </p>
    </header>

    <section class="mb-24">
      <div class="flex justify-between items-end mb-10">
        <div>
          <h2 class="text-3xl font-black text-slate-900 uppercase">Sistemas de Marcado Láser</h2>
          <p class="text-slate-500 font-medium">Fuentes de Fibra Óptica Raycus / Max</p>
        </div>
        <a href="/productos/marcado-laser" class="hidden md:block text-sm font-bold text-orange-600 hover:text-orange-700 uppercase tracking-widest border-b-2 border-orange-500 pb-1 transition-all">
          Explorar Categoría →
        </a>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {equiposLaser.map(producto => (
          <a href={`/productos/${producto.slug}`} class="group relative bg-white border border-slate-200 p-8 rounded-2xl hover:border-orange-500 transition-all hover:shadow-2xl hover:shadow-orange-500/10 flex flex-col justify-between">
            <div>

              <div class="mb-6 aspect-[3/4] bg-slate-50/50 rounded-xl flex items-center justify-center overflow-hidden p-4 border border-slate-100">
                 {producto.data.image ? (
                   <Image 
                     src={producto.data.image} 
                     alt={producto.data.title}
                     width={400}
                     height={533}
                     class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                   />
                 ) : (
                   <span class="text-slate-300 font-bold text-xs uppercase tracking-widest">Sin imagen</span>
                 )}
              </div>

              <h3 class="text-2xl font-black text-slate-900 mb-2 group-hover:text-orange-500 transition-colors uppercase">
                {producto.data.title}
              </h3>
              <p class="text-slate-500 text-sm line-clamp-2 mb-6">
                {producto.data.description}
              </p>
            </div>
            
            <div class="flex items-center text-xs font-black uppercase tracking-widest text-slate-900 pt-2 border-t border-slate-50">
              Ficha Técnica
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2 group-hover:translate-x-2 transition-transform text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </section>
    
    <section class="bg-slate-950 rounded-[2.5rem] p-10 md:p-16 text-white relative overflow-hidden">
      <div class="absolute top-0 right-0 w-1/3 h-full bg-orange-500/10 blur-[120px]"></div>
      
      <div class="relative z-10">
          <div class="mb-12">
              <h2 class="text-3xl font-black uppercase italic tracking-tighter">Sistemas de Limpieza Láser</h2>
              <p class="text-slate-400">Tecnología de pulsos Raycus de alta eficiencia para superficies[cite: 1]</p>
          </div>

          <div class="grid md:grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
              {limpiadoras.map(producto => (
                <a href={`/productos/${producto.slug}`} class="group bg-white/5 border border-white/10 p-8 rounded-2xl hover:bg-white/10 hover:border-orange-500 transition-all flex flex-col justify-between">
                  
                  <div>
                    {/* CAMBIO CLAVE: Cambiamos 'aspect-video' por 'aspect-[4/3]' para hacerlo más angosto y alto */}
                    {producto.data.image && (
                      <div class="mb-6 aspect-[4/3] bg-white/5 rounded-xl overflow-hidden flex items-center justify-center p-6 border border-white/5">
                        <Image 
                          src={producto.data.image} 
                          alt={producto.data.title}
                          width={500}
                          height={375} 
                          class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                        />
                      </div>
                    )}

                    <div class="flex flex-col gap-1 mb-4">
                        <div class="flex items-center justify-between gap-2">
                          <h3 class="text-2xl font-black text-white group-hover:text-orange-500 transition-colors uppercase tracking-tight">
                              {producto.data.title}
                          </h3>
                          <span class="bg-orange-500 text-white text-[9px] font-black px-2 py-0.5 rounded tracking-wider uppercase shrink-0">100W-300W</span>
                        </div>
                    </div>
                    
                    <p class="text-slate-400 text-sm mb-6 leading-relaxed line-clamp-3">
                        {producto.data.description}
                    </p>
                  </div>

                  <span class="text-orange-500 text-xs font-bold uppercase tracking-widest group-hover:underline flex items-center gap-1 pt-4 border-t border-white/5 mt-auto">
                      Especificaciones Técnicas →
                  </span>
                </a>
              ))}
              
              {limpiadoras.length === 1 && (
                <div class="bg-white/[0.02] border border-white/5 p-8 rounded-2xl flex flex-col justify-center">
                  <h4 class="text-sm font-black text-orange-500 uppercase tracking-widest mb-4">Mantenimiento y Superficies</h4>
                  <p class="text-slate-300 text-sm leading-relaxed mb-6">
                    Remoción ecológica y libre de químicos para óxido, pintura, aceites y capas de oxidación sobre metales ferrosos y no ferrosos[cite: 1].
                  </p>
                  <div class="flex flex-col sm:flex-row gap-4 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                    <span class="flex items-center gap-1">⚡ Sistema Portátil[cite: 1]</span>
                    <span class="hidden sm:inline text-slate-700">•</span>
                    <span class="flex items-center gap-1">⚙️ Operación Manual/Auto[cite: 1]</span>
                  </div>
                </div>
              )}
          </div>
      </div>
  </section>
   
  </main>
</Layout>