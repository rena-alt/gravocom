---
// src/components/WhatsappButton.astro
const phone = "5523007699"; 
const message = "Hola Gravocom, me interesa cotizar uno de sus equipos láser.";
const whatsappUrl = `https://wa.me/52${phone}?text=${encodeURIComponent(message)}`;
---

<a 
  href={whatsappUrl} 
  target="_blank" 
  rel="noopener noreferrer" 
  class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-14 h-14 bg-[#25D366] rounded-full shadow-2xl hover:bg-[#128C7E] hover:scale-110 active:scale-95 transition-all duration-300 group"
  aria-label="Contactar por WhatsApp"
>
  <span class="absolute inset-0 rounded-full bg-[#25D366] opacity-40 animate-ping group-hover:animate-none"></span>

  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    viewBox="0 0 24 24" 
    class="w-8 h-8 relative z-10"
  >
    <path 
      fill="#FFFFFF" 
      d="M12.004 2C6.48 2 2 6.48 2 12.004c0 1.848.502 3.578 1.378 5.074L2 22l5.088-1.334c1.442.82 3.11 1.298 4.916 1.298 5.523 0 10.004-4.478 10.004-10.004C22.008 6.48 17.527 2 12.004 2zm4.59 13.013c-.253.71-.97 1.3-1.636 1.516-.576.184-1.325.328-3.85-.71-3.23-1.332-5.314-4.622-5.476-4.84-.162-.217-1.31-1.745-1.31-3.328 0-1.583.824-2.36 1.117-2.67.293-.31.643-.39.86-.39.215 0 .432.003.62.012.197.01.46-.074.72.553.266.643.906 2.21.985 2.373.08.163.13.35.023.565-.107.216-.162.35-.324.543-.162.19-.34.426-.486.57-.162.163-.332.34-.143.663.19.322.845 1.392 1.812 2.255.966.863 1.78 1.13 2.03 1.258.25.13.398.108.547-.065.15-.173.645-.75.817-1.008.172-.26.344-.217.58-.13.236.086 1.5.707 1.758.837.258.13.43.195.494.303.064.108.064.63-.19 1.34z"
    />
  </svg>
</a>